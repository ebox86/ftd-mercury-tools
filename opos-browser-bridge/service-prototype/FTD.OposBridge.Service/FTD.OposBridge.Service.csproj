<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FTD.OposBridge.Service</RootNamespace>
    <AssemblyName>FTD.OposBridge.Service</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <IsPackable>true</IsPackable>
    <PackageId>FTD.OposBridge.Service</PackageId>
    <Authors>FTD</Authors>
    <Description>OPOS scanner bridge service prototype for MercuryHQ barcode modal integration.</Description>
    <PackageTags>opos;barcode;scanner;bridge;mercuryhq</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
</Project>
