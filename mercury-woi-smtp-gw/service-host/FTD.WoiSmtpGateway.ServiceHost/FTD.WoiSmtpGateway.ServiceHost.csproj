    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FTD.WoiSmtpGateway.ServiceHost</AssemblyName>
    <RootNamespace>FTD.WoiSmtpGateway.ServiceHost</RootNamespace>
