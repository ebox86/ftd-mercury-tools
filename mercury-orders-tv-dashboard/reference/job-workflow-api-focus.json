      "signals": [
        "DeliveryZones.SAVED > 0"
      ]
    },
    {
      "stage": "on_truck",
      "description": "Assigned to route/driver and out for delivery.",
      "signals": [
        "DeliveryZones.ON_TRUCK > 0",
        "TicketStatus.DeliveryRoute not empty"
      ]
    },
    {
      "stage": "delivered_or_exception",
      "description": "Delivered or undelivered exception bucket.",
      "signals": [
        "DeliveryZones.DELIVERED > 0",
